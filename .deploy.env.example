# Copy this file to .deploy.env and fill in your handheld's details:
#   cp .deploy.env.example .deploy.env
#
# .deploy.env is gitignored so your personal IP/paths are never committed.
# CLI flags passed to ./scripts/deploy.sh always override values set here.

# Transport method:
#   adb   - USB via bottom USB-C port (built into NextUI, no IP/password needed)
#   ssh   - Wi-Fi via Pak Store's "SSH Server" (Dropbear)
#   local - Direct copy to a mounted microSD card (or USB Mass Storage)
DEPLOY_METHOD="adb"

# Device or platform ID.
# TrimUI Brick, Brick Hammer, and Smart Pro all use "tg5040".
# Friendly aliases like "brick-hammer" also work.
DEPLOY_PLATFORM="tg5040"

# SD card path:
#   - For adb/ssh: always "/mnt/SDCARD" on NextUI
#   - For local on macOS: volume name (e.g. "NEXTUI") or full path ("/Volumes/NEXTUI")
DEPLOY_SDCARD="/mnt/SDCARD"

# Folder name under Tools/<platform>/<name>.pak (without ".pak").
# Tip: set to "Random Game Dev" to test alongside your normal install.
DEPLOY_NAME="Random Game"

# --- SSH options (used when DEPLOY_METHOD="ssh") ---
DEPLOY_HOST=""          # Handheld Wi-Fi IP address, e.g. 192.168.1.42
DEPLOY_USER="root"      # NextUI SSH Server defaults: root (pw: tina) or trimui (pw: trimui)
DEPLOY_PORT="22"
DEPLOY_SSH_KEY=""       # Optional private key path, e.g. ~/.ssh/id_ed25519

# --- ADB options (used when DEPLOY_METHOD="adb") ---
DEPLOY_ADB_SERIAL=""    # Optional: set only if multiple ADB devices are plugged in
